# hpc-session profile. Copy to ~/.config/hpc-session/<name>.conf (chmod 600).
# Shell syntax — it is sourced. Anything already set in the environment wins, so
# one-off overrides need no edit:  HS_HOST=other-login hpc-session status
# An empty value counts as unset, so an empty override falls back to the profile.
#
# The only required key is HS_HOST. Everything else has a working default.

# --- the cluster ------------------------------------------------------------------
# An ssh_config Host alias, or user@hostname. An alias is better: it keeps your key,
# user and jump host in ~/.ssh/config where every other tool can see them too.
HS_HOST=""

# Where job scripts are copied and jobs are submitted from.
HS_REMOTE_WORKDIR="/scratch/\$USER/jobs"

# --- SLURM defaults, used when rendering templates/job.slurm.tmpl -------------------
# Leave a value empty and the matching #SBATCH line is dropped from the rendered script.
HS_SLURM_ACCOUNT=""
HS_SLURM_PARTITION=""
HS_SLURM_TIME="01:00:00"
HS_SLURM_CPUS="1"
HS_SLURM_MEM="4G"
HS_SLURM_NODES="1"
HS_SLURM_NTASKS="1"

# --- polling (watch) ----------------------------------------------------------------
# A shared controller answers squeue for everyone, so the interval has a floor and the
# whole watch has a cap. Both are enforced, and `watch` says when it clamps one.
HS_WATCH_INTERVAL="30"       # default seconds between polls; `watch <id> <n>` overrides
HS_WATCH_MIN_INTERVAL="30"   # a shorter interval is raised to this, out loud
HS_WATCH_MAX_SECONDS="3600"  # stop polling after this long and say how to come back; 0 = no cap
HS_WATCH_MAX_MISSES="3"      # unusable answers in a row before watch stops trusting them

# --- VPN (optional) ----------------------------------------------------------------
# Leave HS_VPN_UP_CMD empty if the cluster is reachable directly. Any VPN works: these
# are just shell commands. HS_VPN_STATUS_CMD must exit 0 when the tunnel is up.
# See docs/vpn-hooks.md for Cisco Secure Client, WireGuard, OpenVPN and Tailscale.
HS_VPN_UP_CMD=""
HS_VPN_DOWN_CMD=""
HS_VPN_STATUS_CMD=""

# --- two-factor authentication (optional) ------------------------------------------
# none     — key-only login (the common case)
# keychain — macOS login Keychain (see HS_TOTP_SERVICE / HS_TOTP_ACCOUNT)
# pass     — the standard unix password manager (see HS_TOTP_PASS_ENTRY)
# file     — a chmod-600 file holding the base32 seed (see HS_TOTP_FILE)
# command  — run your own command, which must print the 6 digits (see HS_TOTP_CMD)
#
# READ docs/2fa-enrollment.md BEFORE choosing anything but `none` or `command`:
# storing the seed beside your SSH key puts both factors on one disk.
HS_TOTP_BACKEND="none"
# No double quote, backslash or newline in these two: `security` parses the command that
# stores the seed, one command per line.
HS_TOTP_SERVICE="hpc-session-totp"
HS_TOTP_ACCOUNT=""
HS_TOTP_PASS_ENTRY=""
HS_TOTP_FILE=""
HS_TOTP_CMD=""

# Google Authenticator's profile. Change only if your site says otherwise.
HS_TOTP_DIGITS="6"
HS_TOTP_PERIOD="30"
HS_TOTP_ALGO="sha1"

# --- connection tuning --------------------------------------------------------------
HS_CONTROL_PERSIST="8h"     # how long an idle master survives
HS_CONNECT_TIMEOUT="25"     # seconds
HS_AUTH_ATTEMPTS="3"        # retries when a TOTP code was already consumed
HS_PYTHON="python3"         # only used to generate TOTP codes
HS_CONTROL_DIR=""           # where master sockets live; empty = ~/.ssh/hpc-session

# --- read from the environment, not from here ---------------------------------------
# These two are consumed before this file is sourced, or instead of it, so an assignment
# here does nothing. Pass them on the command line:
#
#   HS_CONFIG_DIR   where profiles live (default ~/.config/hpc-session)
#                     HS_CONFIG_DIR=/media/key/hpc hpc-session status
#   HS_OTP          one code for one command, instead of any stored seed. The point of the
#                   `none` backend plus a code you type: nothing is stored at all.
#                     HS_OTP=123456 hpc-session open
